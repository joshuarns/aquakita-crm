# === Aplicación (producción) ===
APP_NAME="Aquakita"
APP_ENV=production
APP_KEY=            # generar con: php artisan key:generate
APP_DEBUG=false     # NUNCA true en producción
APP_URL=https://leads.aquakita.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# Zona horaria de operación (§10). Ajustar a la del cliente.
APP_TIMEZONE=America/Mexico_City

# === Base de datos: MySQL / MariaDB ===
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquakita
DB_USERNAME=aquakita
DB_PASSWORD=          # contraseña fuerte

# === Sesión, caché y colas ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database   # correr un worker (ver DESPLIEGUE.md)

# === Almacenamiento de adjuntos (§5) ===
# 'local' guarda en storage/app/private (no público, se sirve por ruta con permiso).
FILESYSTEM_DISK=local

# === Correo saliente real (§4.3) ===
MAIL_MAILER=smtp
MAIL_HOST=            # p. ej. smtp.mailgun.org / smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@aquakita.com"
MAIL_FROM_NAME="${APP_NAME}"
